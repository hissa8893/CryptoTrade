# Secrets live ONLY in this file (.env). It is gitignored and set to owner-only
# permissions by the installer. There are NO exchange API keys - this app only
# reads public market data and never trades.

# --- Email alerts (alerts.channel: email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Telegram alerts (alerts.channel: telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional LLM analyst layer (llm.enabled: true) ---
ANTHROPIC_API_KEY=
